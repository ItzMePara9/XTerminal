# ------------------------------------------------------------------
# XTerminal environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env file.
# ------------------------------------------------------------------

NODE_ENV=production

# HTTP server
HOST=0.0.0.0
PORT=7132

# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://xterminal:change-me@localhost:5432/xterminal

# 32-byte secret used to sign session identifiers (openssl rand -hex 32)
SESSION_SECRET=

# 32-byte master key for the credential vault (openssl rand -hex 32).
# Encrypts SSH passwords / private keys / passphrases at rest (AES-256-GCM).
# If lost, all stored credentials become unreadable.
ENCRYPTION_KEY=

# Public URL of the app (used for email links + WebAuthn)
APP_URL=http://localhost:7132

# WebAuthn / FIDO2 (must match your real domain in production)
WEBAUTHN_RP_NAME=XTerminal
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:7132

# ---- Resource limits ------------------------------------------------
MAX_CONNECTIONS_PER_USER=200
MAX_ACTIVE_SESSIONS_PER_USER=10
SSH_CONNECTION_TIMEOUT=15000
SSH_AUTH_TIMEOUT=15000
SSH_IDLE_TIMEOUT=3600000
WS_RECONNECT_GRACE=30000

# ---- Email (optional) ------------------------------------------------
# SMTP connection string, e.g. smtps://user:pass@smtp.example.com:465
# When empty, verification / reset links are written to the server log
# instead of being emailed.
SMTP_URL=
EMAIL_FROM=XTerminal <no-reply@example.com>

# Force users to verify email before first login (requires SMTP_URL)
EMAIL_VERIFICATION_REQUIRED=false

# ---- Redis (optional, used for rate limiting when present) -----------
REDIS_URL=
